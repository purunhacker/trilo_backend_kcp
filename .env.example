# Local review only. Never use these local database/storage defaults in production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trilo
DB_USER=trilo
DB_PASSWORD=trilo

# Generate a local signing secret with: openssl rand -hex 32
ADMIN_JWT_SECRET=
# Optional one-time bootstrap. Leave both empty to skip account creation.
ADMIN_BOOTSTRAP_USERNAME=
# At least 16 characters; generate a new local password.
ADMIN_BOOTSTRAP_PASSWORD=

# For stable auth-service keys, generate a local RSA pair outside this repository:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out /tmp/trilo-local-private.pem
# openssl pkey -in /tmp/trilo-local-private.pem -pubout -out /tmp/trilo-local-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Generate separate random tokens if enabling service-to-service APIs.
INTERNAL_MAIL_TOKEN=
INTERNAL_NOTIFICATION_TOKEN=
INTERNAL_AI_TOKEN=
INTERNAL_WEATHER_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
